<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:maui_app_ieradumi.ViewModels"
             x:Class="maui_app_ieradumi.MainPage"
             x:DataType="vm:mainViewModel"
             Title="Ieradumi">

    <Grid RowDefinitions="Auto, *"
          Padding="20"
          RowSpacing="15">

        <!-- Ряд 0: Шапка -->
        <VerticalStackLayout Grid.Row="0"
                             Spacing="10">
            <HorizontalStackLayout Spacing="5">
                <Label Text="{Binding TopText1}"
                       FontSize="22"
                       FontAttributes="Bold" />
                <Label Text="{Binding TopText2}"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="Blue" />
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="*, Auto"
                  ColumnSpacing="10">
                <Picker Title="Izvēlieties laika posmu"
                        ItemsSource="{Binding TimeRanges}"
                        SelectedItem="{Binding SelectedTimeRange}" />

                <Button Grid.Column="1"
                        Text="Pārslēgt režīmu"
                        Command="{Binding SwitchModeCommand}" />
            </Grid>
        </VerticalStackLayout>

        <!-- Ряд 1: Контент режимов -->
        <Grid Grid.Row="1">

            <!-- 1. РЕЖИМ NEXT -->
            <CollectionView ItemsSource="{Binding NextHabits}"
                            IsVisible="{Binding NextMode}">
                <CollectionView.EmptyView>
                    <Label Text="Nav aktīvu ieradumu"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HabitDisplayItem">
                        <Frame Margin="0,5"
                               Padding="12"
                               CornerRadius="8">
                            <Grid ColumnDefinitions="*, Auto"
                                  ColumnSpacing="10">
                                <VerticalStackLayout VerticalOptions="Center"
                                                     Spacing="3">
                                    <Label Text="{Binding Title}"
                                           FontSize="16"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding Description}"
                                           FontSize="13"
                                           TextColor="Gray" />
                                    <Label Text="{Binding ScheduledTimeFormatted}"
                                           FontSize="11"
                                           TextColor="DarkBlue" />
                                </VerticalStackLayout>

                                <Button Grid.Column="1"
                                        Text="Atzīmēt"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:mainViewModel}}, Path=CompleteHabitCommand}"
                                        CommandParameter="{Binding .}"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- 2. РЕЖИМ PREVIOUS -->
            <CollectionView ItemsSource="{Binding PreviousHabits}"
                            IsVisible="{Binding PreviouseMode}">
                <CollectionView.EmptyView>
                    <Label Text="Nav vēstures ierakstu"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HabitDisplayItem">
                        <Frame Margin="0,5"
                               Padding="12"
                               CornerRadius="8">
                            <HorizontalStackLayout Spacing="15"
                                                   VerticalOptions="Center">
                                <Label Text="{Binding Title}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding IsInTime, StringFormat='Laikā: {0}'}"
                                       FontSize="13"
                                       TextColor="Green"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- 3. РЕЖИМ SCHEDULE (Все привычки + Детализированная форма с днями) -->
            <CollectionView ItemsSource="{Binding AllSchedules}"
                            IsVisible="{Binding ScheduleMode}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="15"
                                         Padding="10">
                        <Label Text="Nav grafika ierakstu"
                               HorizontalOptions="Center"
                               TextColor="Gray" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HabitDisplayItem">
                        <Frame Margin="0,5"
                               Padding="12"
                               CornerRadius="8">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding Title}"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding Description}"
                                       FontSize="13"
                                       TextColor="Gray" />
                                <Label Text="{Binding ScheduledTimeFormatted}"
                                       FontSize="12"
                                       TextColor="Purple" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- ФОРМА СОЗДАНИЯ С ВЫБОРОМ ДНЕЙ НЕДЕЛИ И ВРЕМЕНИ -->
                <CollectionView.Footer>
                    <VerticalStackLayout Spacing="10"
                                         Padding="0,20,0,10"
                                         BackgroundColor="Transparent">
                        <BoxView HeightRequest="1"
                                 Color="LightGray"
                                 Margin="0,0,0,10" />
                        <Label Text="Pievienot jaunu ieradumu un grafiku"
                               FontAttributes="Bold"
                               FontSize="14" />

                        <Entry Text="{Binding NewHabbitName}"
                               Placeholder="Ieraduma nosaukums..." />
                        <Entry Text="{Binding NewHabbitDescription}"
                               Placeholder="Apraksts..." />

                        <Label Text="Izvēlieties dienas un laiku:"
                               FontAttributes="Bold"
                               Margin="0,5,0,0" />

                        <!-- Список дней недели с чекбоксами и полями времени -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding WeekDays}"
                                             Spacing="5">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:DayScheduleItem">
                                    <Grid ColumnDefinitions="Auto, *, Auto"
                                          ColumnSpacing="10">
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected}"
                                                  VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding DayName}"
                                               VerticalOptions="Center"
                                               FontSize="14" />

                                        <!-- Заменили Entry на TimePicker -->
                                        <TimePicker Grid.Column="2"
                                                    Time="{Binding SelectedTime}"
                                                    IsEnabled="{Binding IsSelected}"
                                                    WidthRequest="120" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Button Text="Pievienot ieradumu grafikam"
                                Command="{Binding AddHabitWithScheduleCommand}"
                                BackgroundColor="Green"
                                TextColor="White"
                                Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </CollectionView.Footer>

            </CollectionView>

        </Grid>

    </Grid>
</ContentPage>