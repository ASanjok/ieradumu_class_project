<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="maui_app_ieradumi_2.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:maui_app_ieradumi_2"
    xmlns:views ="clr-namespace:maui_app_ieradumi_2.Views"
    Title="maui_app_ieradumi_2">

    <FlyoutItem Title="Auth"
                FlyoutItemIsVisible="False">
        <ShellContent Title="Auth Page"
                      ContentTemplate="{DataTemplate views:AuthPage}"
                      Route="AuthPage" />
    </FlyoutItem>
    <FlyoutItem Title="Habit">
        <ShellContent Title="List"
                  ContentTemplate="{DataTemplate views:HabitListPage}"
                  Route="HabitListPage" />
        <ShellContent Title="Edit"
                  ContentTemplate="{DataTemplate views:EditHabitPage}"
                  Route="EditHabitPage" />
        <ShellContent Title="create"
                  ContentTemplate="{DataTemplate views:AddHabitPage}"
                  Route="AddHabitPage" />
    </FlyoutItem>
    <ShellContent Title="User Info"
                  ContentTemplate="{DataTemplate views:UserInfoPage}"
                  Route="UserInfoPage" />
    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="20">
            <HorizontalStackLayout Spacing="15"
                                   VerticalOptions="Center">

                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLogoutClicked" />
                </HorizontalStackLayout.GestureRecognizers>

                <Image Source="logout_icon.png"
                       HeightRequest="24"
                       WidthRequest="24" />

                <Label Text="Logout"
                       VerticalOptions="Center"
                       FontSize="16" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Shell.FlyoutFooter>
</Shell>
