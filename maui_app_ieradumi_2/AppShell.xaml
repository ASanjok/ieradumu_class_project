<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="maui_app_ieradumi_2.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:maui_app_ieradumi_2"
    xmlns:views ="clr-namespace:maui_app_ieradumi_2.Views"
    Title="maui_app_ieradumi_2">

    <FlyoutItem Title="Auth"
                FlyoutItemIsVisible="False">
        <ShellContent Title="Auth Page"
                      ContentTemplate="{DataTemplate views:AuthPage}"
                      Route="AuthPage" />
    </FlyoutItem>
    <ShellContent Title="Ieradumu saraksts"
                  ContentTemplate="{DataTemplate views:HabitListPage}"
                  Route="HabitListPage" />
    <MenuItem Text="logout"
              Clicked="OnLogoutClicked"
              IconImageSource="logout_icon.png"/>
</Shell>
