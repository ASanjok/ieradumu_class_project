<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui_app_ieradumi_2.Views.AddHabitPage"
             Title="AddHabitPage">
    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="15">

            <VerticalStackLayout Spacing="5">
                <Label Text="Habit Name:"
                       FontAttributes="Bold" />
                <Entry Text="{Binding CurrentHabit.HabitName}"
                       Placeholder="enter habit name" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Habit Description:"
                       FontAttributes="Bold" />
                <Entry Text="{Binding CurrentHabit.HabitDescription}"
                       Placeholder="enter habit description" />
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="10"
                                   VerticalOptions="Center">
                <Label Text="Archived"
                       VerticalOptions="Center" />
                <CheckBox IsChecked="{Binding CurrentHabit.Archived}" />
            </HorizontalStackLayout>

            <Button Text="Create"
                    Command="{Binding CreateButtonCommand}"
                    Margin="0,20,0,0"
                    HeightRequest="45" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>