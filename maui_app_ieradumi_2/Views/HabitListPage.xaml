<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui_app_ieradumi_2.Views.HabitListPage"
             xmlns:elements="clr-namespace:maui_app_ieradumi_2.Views.Elements"
             Title="HabitListPage">

    <Grid RowDefinitions="Auto, *"
          Margin="0,25,0,0">
        <VerticalStackLayout Grid.Row="0"
                             Margin="0,0,0,25"
                             HorizontalOptions="Center"
                             Spacing="15">
            <HorizontalStackLayout HorizontalOptions="Center"
                                   Spacing="10">
                <Label Text="{Binding TopText}"
                       VerticalOptions="Center" />

                <Button Text="{Binding RefreshButtonText}"
                        Command="{Binding RefreshButtonCommand}" />
            </HorizontalStackLayout>

            <Button Text="{Binding AddHabitButtonText}"
                    Command="{Binding AddHabitButtonCommand}"
                    HeightRequest="45" />

        </VerticalStackLayout>

        <CollectionView ItemsSource="{Binding Habits}"
                        Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <elements:HabitInfoElement Margin="0,5" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>