<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui_app_ieradumi_2.Views.UserInfoPage"
             Title="UserInfoPage">
    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="15">

            <VerticalStackLayout Spacing="5">
                <Label Text="User ID:"
                       FontAttributes="Bold"
                       TextColor="Gray" />
                <Entry Text="{Binding CurrentUser.ID}"
                       IsReadOnly="True"
                       BackgroundColor="#F0F0F0"
                       TextColor="DarkGray" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Username:"
                       FontAttributes="Bold" />
                <Entry Text="{Binding CurrentUser.Username}"
                       Placeholder="Введите имя пользователя" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Email:"
                       FontAttributes="Bold" />
                <Entry Text="{Binding CurrentUser.Email}"
                       Placeholder="example@mail.com"
                       Keyboard="Email" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Password:"
                       FontAttributes="Bold" />
                <Entry Text="{Binding CurrentUser.Password}"
                       Placeholder="Введите пароль"
                       IsPassword="True" />
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="10"
                                   VerticalOptions="Center"
                                   Margin="0,5,0,0">
                <CheckBox IsChecked="{Binding CurrentUser.Archived}" />
                <Label Text="Account is Archived"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Frame BorderColor="LightGray"
                   CornerRadius="8"
                   Padding="15"
                   Margin="0,10,0,0"
                   HasShadow="False">
                <VerticalStackLayout Spacing="10">

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Creation Date:"
                               FontAttributes="Bold" />
                        <Label Text="{Binding CurrentUser.UserCreationDate, StringFormat='{0:dd.MM.yyyy HH:mm}'}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Last Change Date:"
                               FontAttributes="Bold" />
                        <Label Text="{Binding CurrentUser.UserLastChangeDate, StringFormat='{0:dd.MM.yyyy HH:mm}'}" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <Button Text="Save Changes"
                    Command="{Binding SaveUserCommand}"
                    Margin="0,20,0,0"
                    HeightRequest="45" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>