<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui_app_ieradumi_2.Views.EditHabitPage"
             Title="EditHabitPage">
    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="15">

            <VerticalStackLayout Spacing="5">
                <Label Text="ID:"
                       FontAttributes="Bold"
                       TextColor="Gray" />
                <Entry Text="{Binding CurrentHabit.ID}"
                       IsReadOnly="True"
                       BackgroundColor="#F0F0F0" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Habit Name:"
                       FontAttributes="Bold" />
                <Entry Text="{Binding CurrentHabit.HabitName}"
                       Placeholder="enter habit name" />
            </VerticalStackLayout>
            
            <VerticalStackLayout Spacing="5">
                <Label Text="Habit Description:"
                       FontAttributes="Bold" />
                <Entry Text="{Binding CurrentHabit.HabitDescription}"
                       Placeholder="enter habit description" />
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="10"
                                   VerticalOptions="Center">
                <Label Text="Archived"
                       VerticalOptions="Center" />
                <CheckBox IsChecked="{Binding CurrentHabit.Archived}" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <Label Text="Creation Date:"
                       FontAttributes="Bold" />
                <Label Text="{Binding CurrentHabit.CreationDate}" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <Label Text="Last Change Date:"
                       FontAttributes="Bold" />
                <Label Text="{Binding CurrentHabit.LastChangeDate}" />
            </HorizontalStackLayout>

            <Button Text="Save"
                    Command="{Binding SaveButtonCommand}"
                    Margin="0,20,0,0"
                    HeightRequest="45" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>